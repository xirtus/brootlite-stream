<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_focused" />
            <stroke android:width="1.5dp" android:color="@color/focus_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_elevated" />
            <stroke android:width="1dp" android:color="@color/border_selected" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_pill_idle" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
